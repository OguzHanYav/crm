# Kopieren nach asterisk.env (NICHT committen — steht in .gitignore).
# Diese Datei liegt nur auf dem Telefonanlagen-Server.

# --- Nebenstellen der Mitarbeiter (WebRTC im Browser) ------------------------
# Format: Durchwahl:Passwort:Anzeigename; mehrere mit ";" trennen.
# Passwörter lang & zufällig (z. B. `openssl rand -hex 16`) und IDENTISCH zu
# SIP_ACCOUNTS in der .env des CRM.
PBX_WEBRTC_USERS=1001:bitte-aendern-1001:Mitarbeiter Eins;1002:bitte-aendern-1002:Mitarbeiter Zwei

# Realm der Digest-Anmeldung — muss SIP_REALM im CRM entsprechen.
PBX_REALM=asterisk

# --- Server/Netzwerk ------------------------------------------------------------
# Öffentliche IP des Servers, falls er selbst eine private IP hat (Cloud-NAT).
PBX_PUBLIC_IP=
# Optional: STUN für Asterisk selbst (nur hinter NAT nötig).
PBX_STUN_ADDR=
# Nur setzen, wenn Asterisk WSS selbst terminiert (ohne nginx), sonst leer lassen:
PBX_TLS_CERT=
PBX_TLS_KEY=

# --- SIP-Trunk: NACH DEM KAUF DER LEITUNG AUSFÜLLEN ------------------------------
# Werte stehen im Kundenportal des Anbieters (Bezeichnungen variieren, siehe
# docs/telefonie/README.md → Checkliste).
PBX_TRUNK_HOST=
PBX_TRUNK_USER=
PBX_TRUNK_PASSWORD=
# Nur falls abweichend (sonst = PBX_TRUNK_USER bzw. PBX_TRUNK_HOST):
PBX_TRUNK_AUTH_USER=
PBX_TRUNK_REGISTRAR=
# Eigene Rufnummer, die der Angerufene sieht (Format laut Anbieter, oft 49…/+49…).
PBX_TRUNK_CALLERID=
# Wie der Anbieter internationale Nummern erwartet: "00" (0049…) oder "+" (+49…).
PBX_TRUNK_DIAL_PREFIX=00
